# 扶摇金融数据 API
FUYAO_API_KEY=your_fuyao_api_key
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# LLM（默认 DeepSeek，OpenAI 兼容接口）
# 密钥获取：https://platform.deepseek.com/api_keys
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# iFinD MCP（解释增强，不参与筛选判定）
# 密钥：https://mcp.51ifind.com → 个人中心 → 密钥管理
IFIND_MCP_TOKEN=your_ifind_mcp_token

# 服务
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SQLITE_PATH=./data/strategies.db

# 演示模式：无真实 Key 时使用内置 mock 数据跑通主链路
USE_MOCK_DATA=false
